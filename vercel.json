{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm prisma:generate && pnpm prisma:migrate:deploy && pnpm prisma:seed && pnpm build",
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ]
}
